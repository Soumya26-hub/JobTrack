# Copy this file to .env and fill in what you have. Never commit .env.
# Missing values are fine: that job source is simply skipped.

# Adzuna: free developer account at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Jooble: request a free key on Jooble's API page
JOOBLE_API_KEY=

# Company career boards (no key needed), comma-separated
# Greenhouse board token = the name in boards.greenhouse.io/<token>
GREENHOUSE_BOARDS=
# Lever company slug = the name in jobs.lever.co/<slug>
LEVER_COMPANIES=
